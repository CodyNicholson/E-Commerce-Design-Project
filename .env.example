# Copy to .env (git-ignored) and fill in. pipeline-run.sh creates .env from this file
# when it is missing and generates DB_PASSWORD if it is empty.

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server
TUNNEL_TOKEN=

# Postgres credentials. DB_PASSWORD is required (docker compose refuses to start without it);
# use a long random value, e.g. `openssl rand -hex 24`. DB_USER and DB_NAME default to mro.
# The database is never published outside the Docker network. These only take effect when the
# pgdata volume is first created: changing them later needs ALTER USER inside Postgres.
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin token for POST /api/admin/reset (the footer's "Reset demo data" asks for it).
# Leave empty to switch the endpoint off, which is the safe default for the public site.
ADMIN_TOKEN=

# The public base URL of the site, used in the PunchOut StartPage and cart-return URLs the
# API hands back (default http://localhost:8090). Set it to the tunnel's hostname in prod,
# e.g. https://your-domain.example
PUBLIC_URL=

# Host port for the web app (default 8090). It is bound to 127.0.0.1 only.
WEB_PORT=
