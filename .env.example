# Copy to .env (git-ignored) and fill in. pipeline-run.sh creates .env from this file
# when it is missing. Leave a value empty to use the built-in default.

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server
TUNNEL_TOKEN=

# Postgres credentials (default: mro / mro-local-only / mro). The database is never
# published outside the Docker network. Only take effect when the pgdata volume is first created.
DB_USER=
DB_PASSWORD=
DB_NAME=

# The public base URL of the site, used in the PunchOut StartPage and cart-return URLs the
# API hands back (default http://localhost:8090). Set it to the tunnel's hostname in prod,
# e.g. https://your-domain.example
PUBLIC_URL=

# Host port for the web app (default 8090)
WEB_PORT=
